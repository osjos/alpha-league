modules = ["nodejs-20", "java", "java-graalvm22.3"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Alpha League Auto"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow]]
name = "Alpha League Auto"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:auto"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3002

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 34835
externalPort = 3003
exposeLocalhost = true

[[ports]]
localPort = 36253
externalPort = 4200
exposeLocalhost = true

[[ports]]
localPort = 40303
externalPort = 3001
exposeLocalhost = true

[[ports]]
localPort = 41949
externalPort = 3000
exposeLocalhost = true

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[deployment]
deploymentTarget = "vm"
run = ["node", "server.js"]
build = ["npm", "run", "build"]
