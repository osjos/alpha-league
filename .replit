modules = ["nodejs-20", "java", "java-graalvm22.3"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Alpha League Auto"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "API Server"

[[workflows.workflow]]
name = "Alpha League Auto"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev:auto"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "API Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 3001

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 32857
externalPort = 3003
exposeLocalhost = true

[[ports]]
localPort = 41949
externalPort = 3000
exposeLocalhost = true

[[ports]]
localPort = 8080
externalPort = 8080

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[deployment]
deploymentTarget = "autoscale"
run = ["npm", "run", "preview", "--", "--host", "0.0.0.0", "--port", "5000"]
build = ["npm", "run", "build"]
